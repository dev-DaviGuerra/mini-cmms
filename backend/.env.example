# Copie para backend/.env e preencha. NUNCA commite o .env.
# Banco de desenvolvimento (usado pela API e pelo seed). Ex.: Neon ou PostgreSQL local.
#   Neon:  postgresql://USUARIO:SENHA@HOST.neon.tech/cmms?sslmode=require
#   Local: postgres://postgres:SENHA@localhost:5432/cmms
DATABASE_URL=
# Banco SÓ para testes (npm test). Precisa ser diferente do DATABASE_URL.
DATABASE_URL_TEST=

# Mínimo de 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000

# Senha dos usuários fictícios criados pelo seed
SEED_PASSWORD=troque-esta-senha
