# Copie para backend/.env e preencha. NUNCA commite o .env.
# Multiempresa (#41): duas URLs por banco.
#   DATABASE_URL       papel maintos_app (usado pela API). Sem BYPASSRLS e sem ser dono das
#                      tabelas: a Row-Level Security vale para ele. A API se recusa a subir
#                      com um papel que ignora a RLS.
#   DATABASE_URL_ADMIN dono das tabelas (cmms_owner no Neon, postgres local): migrações
#                      (database/0*.sql) e seed. Nunca no Render.
#   Neon:  postgresql://maintos_app:SENHA@HOST.neon.tech/cmms?sslmode=require
#   Local: postgres://maintos_app:SENHA@localhost:5432/cmms
DATABASE_URL=
DATABASE_URL_ADMIN=
# Banco SÓ para testes (npm test), com as mesmas duas URLs. Diferentes das de desenvolvimento.
DATABASE_URL_TEST=
DATABASE_URL_TEST_ADMIN=

# Mínimo de 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000

# Tentativas de login por IP a cada 15 min. Padrão 10 (use 10 em produção).
# Em desenvolvimento pode ser maior, para os testes no navegador não bloquearem o login.
LOGIN_RATE_LIMIT_MAX=10

# Pedidos de acesso (formulário público da landing) por IP a cada hora. Padrão 5.
SOLICITACAO_RATE_LIMIT_MAX=5

# Número de proxies entre o cliente e a API (trust proxy do Express). Padrão 1: no Render,
# o balanceador de carga. Inteiro de 0 a 5.
TRUST_PROXY=1

# Senha dos usuários fictícios criados pelo seed
SEED_PASSWORD=troque-esta-senha
