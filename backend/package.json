{
  "name": "mini-cmms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Mini-CMMS (Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
